<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hostwover Cloud Hosting</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            color: #0f172a;

            background:
                radial-gradient(
                    circle at 20% 20%,
                    rgba(0, 167, 106, 0.10),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 80% 80%,
                    rgba(0, 203, 208, 0.10),
                    transparent 30%
                ),
                #f8fafc;

            overflow: hidden;
        }

        /* Background grid */
        body::before {
            content: "";
            position: fixed;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(15, 23, 42, 0.035) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(15, 23, 42, 0.035) 1px,
                    transparent 1px
                );

            background-size: 40px 40px;

            mask-image:
                linear-gradient(
                    to bottom,
                    rgba(0, 0, 0, 0.8),
                    transparent
                );

            pointer-events: none;
        }

        .wrapper {
            position: relative;
            width: 100%;
            max-width: 900px;
            padding: 40px 24px;
            text-align: center;
            z-index: 1;
        }

        /* Bigger Logo */
        .logo-container {
            width: 150px;
            height: 150px;

            margin: 0 auto 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 36px;

            background: rgba(255, 255, 255, 0.85);

            border: 1px solid rgba(15, 23, 42, 0.08);

            box-shadow:
                0 20px 50px rgba(15, 23, 42, 0.08),
                0 5px 20px rgba(0, 167, 106, 0.10);

            backdrop-filter: blur(16px);
        }

        .logo-container img {
            width: 120px;
            height: 120px;
            object-fit: contain;
        }

        /* Heading */
        h1 {
            max-width: 800px;
            margin: 0 auto;

            font-size: clamp(42px, 7vw, 72px);
            line-height: 1.04;
            letter-spacing: -3px;
            font-weight: 750;
        }

        .highlight {
            background: linear-gradient(
                90deg,
                #008f5b,
                #00a76a,
                #00aeb4
            );

            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .description {
            max-width: 600px;

            margin: 24px auto 0;

            color: #64748b;

            font-size: 17px;
            line-height: 1.7;
        }

        /* Button */
        .hostwover-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            margin-top: 30px;
            padding: 14px 22px;

            min-height: 50px;

            border-radius: 12px;

            background: #00a76a;
            color: #ffffff;

            font-size: 15px;
            font-weight: 650;

            text-decoration: none;

            box-shadow:
                0 10px 25px rgba(0, 167, 106, 0.18);

            transition:
                transform 0.2s ease,
                background 0.2s ease,
                box-shadow 0.2s ease;
        }

        .hostwover-button:hover {
            background: #008f5b;

            transform: translateY(-2px);

            box-shadow:
                0 14px 32px rgba(0, 167, 106, 0.24);
        }

        .hostwover-button svg {
            width: 17px;
            height: 17px;
        }

        @media (max-width: 600px) {
            .wrapper {
                padding: 28px 20px;
            }

            .logo-container {
                width: 120px;
                height: 120px;

                margin-bottom: 26px;

                border-radius: 30px;
            }

            .logo-container img {
                width: 96px;
                height: 96px;
            }

            h1 {
                font-size: clamp(38px, 12vw, 54px);
                letter-spacing: -2px;
            }

            .description {
                font-size: 15px;
                line-height: 1.6;
            }

            .hostwover-button {
                width: 100%;
                max-width: 300px;

                margin-top: 26px;
            }
        }
    </style>
</head>

<body>

    <main class="wrapper">

        <div class="logo-container">
            <img
                src="/logo.png"
                alt="Hostwover Logo"
                onerror="this.style.display='none'"
            />
        </div>

        <h1>
            Hostwover
            <br />
            <span class="highlight">Cloud Hosting</span>
        </h1>

        <p class="description">
            High-performance cloud infrastructure powered by
            enterprise-grade server technology.
        </p>

         
        <a
            href="https://hostwover.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hostwover-button"
        >
            Visit Hostwover.com

            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M5 12h14"></path>
                <path d="m13 6 6 6-6 6"></path>
            </svg>
        </a>
            <h5>
            Powered By Engineer
            <br />
            <span class="highlight">Ahmed Mokhtar</span>
        </h5>
    </main>

</body>
</html>